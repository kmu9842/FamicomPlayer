{
  "manifest_version": 3,
  "name": "FamicomPlayer로 재생",
  "version": "1.0.0",
  "description": "유튜브에서 우클릭해 FamicomPlayer로 재생합니다. 앱이 꺼져 있으면 함께 실행합니다.",
  "minimum_chrome_version": "123",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "youtube-menu.js"
      ],
      "css": [
        "youtube-menu.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/32.png"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "FamicomPlayer로 재생",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
