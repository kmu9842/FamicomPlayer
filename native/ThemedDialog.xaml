<Window x:Class="FamicomPlayer.ThemedDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="392" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
    UseLayoutRounding="True" FontFamily="Malgun Gothic" PreviewKeyDown="DialogKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RetroTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="DialogAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontSize" Value="12"/><Setter Property="MinWidth" Value="80"/><Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="#D8DADC"/><Setter Property="BorderBrush" Value="#A3A7AD"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".85"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".65"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#383D43"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="18,12,18,18" CornerRadius="12" Background="#FDE7E9EC" BorderBrush="#383D43" BorderThickness="2,2,2,6">
        <Grid KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Background="Transparent" MouseLeftButtonDown="DragHeader">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" Style="{StaticResource DialogAction}" Background="Transparent" BorderThickness="0" Click="Dismiss" ToolTip="닫기" AutomationProperties.Name="대화상자 닫기" KeyboardNavigation.TabIndex="2">
                    <Path Data="M1,1 L9,9 M9,1 L1,9" Width="10" Height="10" Stroke="#494949" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <TextBlock x:Name="Heading" Foreground="#383D43" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" Margin="0,20,0,22" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="280" Focusable="False">
                <TextBlock x:Name="MessageText" Foreground="#494949" FontSize="12" LineHeight="21" TextWrapping="Wrap"/>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="취소" Style="{StaticResource DialogAction}" Margin="0,0,8,0" IsCancel="True" Click="Dismiss" KeyboardNavigation.TabIndex="0"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource DialogAction}" Background="#454C55" Foreground="#F1F1F1" BorderBrush="#353B43" Click="Accept" KeyboardNavigation.TabIndex="1"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
