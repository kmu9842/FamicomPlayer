<Window x:Class="FamicomPlayer.LibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FamicomPlayer" Title="게임팩" Width="680" Height="550" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontFamily="Malgun Gothic">
    <Window.Resources><ResourceDictionary>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#353A40"/><Setter Property="FontSize" Value="11"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#F4F5F7"/><Setter Property="Foreground" Value="#3B3B3B"/><Setter Property="CaretBrush" Value="#3D3D3D"/><Setter Property="BorderBrush" Value="#AAAAAA"/><Setter Property="Padding" Value="9,8"/><Setter Property="FontSize" Value="11"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="Button"><Setter Property="Foreground" Value="#404040"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#ABABAB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,7"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value=".72"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value=".5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/></Style>
    </ResourceDictionary></Window.Resources>
    <Border Background="#E7E9EC" BorderBrush="#383D43" BorderThickness="2,2,2,7" CornerRadius="11" Padding="20,12,20,15">
    <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Background="Transparent" MouseLeftButtonDown="DragHeader"><Button Content="×" DockPanel.Dock="Right" Width="28" BorderThickness="0" Padding="0" FontSize="20" Click="CloseLibrary" ToolTip="닫기"/><TextBlock Text="게임팩" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/></DockPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button x:Name="BackButton" Content="←" Click="BackToLibrary" Padding="8,3" Margin="0,0,7,0" Visibility="Collapsed" ToolTip="전체 보관함"/><TextBlock x:Name="LocationTitle" Text="전체 보관함" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/></DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,9"><TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="게임팩 검색"/><TextBlock Text="검색" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#969696"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                <Button DockPanel.Dock="Bottom" Content="+ 게임팩 / 모음 추가" Click="NewCartridge" Margin="0,8,0,0"/>
                <Grid><TextBlock x:Name="EmptyMessage" Text="저장된 게임팩 없음" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#858585"/>
                    <ListBox x:Name="Cards" Background="Transparent" BorderThickness="0" SelectionChanged="SelectCartridge" MouseDoubleClick="ActivateCard" KeyDown="CardKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="#E3E3E3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#CDD2D9"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#8E8E8E"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Grid Loaded="CardVisible" DataContextChanged="CardContextChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="99"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="94" Height="75">
                                <Grid Width="78" Height="57" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,0,0,0" Visibility="{Binding IsCollection, Converter={StaticResource BooleanVisibility}}"><Image Source="{Binding Shell}" Stretch="Fill"/><local:CartridgeDisplay Source="{Binding ThirdCover}" Margin="7,7,7,13"/></Grid>
                                <Grid Width="78" Height="57" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,7,0,0" Visibility="{Binding IsCollection, Converter={StaticResource BooleanVisibility}}"><Image Source="{Binding Shell}" Stretch="Fill"/><local:CartridgeDisplay Source="{Binding SecondCover}" Margin="7,7,7,13"/></Grid>
                                <Grid Width="78" Height="57" HorizontalAlignment="Left" VerticalAlignment="Bottom"><Image Source="{Binding Shell}" Stretch="Fill"/><local:CartridgeDisplay Source="{Binding Cover}" Margin="7,7,7,13"/></Grid>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="43" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Margin="0,5,0,0" Foreground="#69727B" FontSize="10"/></StackPanel>
                        </Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Grid Width="262" Height="180" Margin="0,0,0,9">
                    <Grid x:Name="PreviewBackTwo" Width="230" Height="153" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,0,0,0" Visibility="Collapsed"><Image x:Name="PreviewBackShellTwo" Stretch="Fill"/><local:CartridgeDisplay x:Name="PreviewBackCoverTwo" Margin="23,21,23,35"/></Grid>
                    <Grid x:Name="PreviewBackOne" Width="230" Height="153" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,12,0,0" Visibility="Collapsed"><Image x:Name="PreviewBackShellOne" Stretch="Fill"/><local:CartridgeDisplay x:Name="PreviewBackCoverOne" Margin="23,21,23,35"/></Grid>
                    <Grid Width="230" Height="153" HorizontalAlignment="Left" VerticalAlignment="Bottom"><Image x:Name="PreviewShell" Stretch="Fill"/><local:CartridgeDisplay x:Name="CoverPreview" Margin="23,21,23,35"/></Grid>
                </Grid>
                <TextBlock x:Name="VideoTitle" Text="" Height="35" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
                <TextBlock Text="영상 또는 재생목록 링크" Foreground="#69727B" Margin="0,0,0,5"/>
                <TextBox x:Name="UrlInput" TextChanged="UrlChanged" ToolTip="재생목록 링크는 모든 영상을 게임팩 모음으로 만듭니다." AutomationProperties.Name="게임팩 유튜브 링크"/>
                <DockPanel x:Name="ImportProgress" Margin="0,8,0,0" Visibility="Collapsed"><Button Content="취소" DockPanel.Dock="Right" Padding="7,3" Click="CancelImport"/><ProgressBar Height="4" IsIndeterminate="True" Margin="0,0,8,0"/></DockPanel>
                <Grid x:Name="CoverButtons" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="커버 변경" Click="ChooseImage"/><Button Grid.Column="2" Content="기본 썸네일" Click="UseThumbnail"/></Grid>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="저장" Click="SaveCartridge" Background="#454C55" Foreground="#F1F1F1" BorderBrush="#353B43" IsEnabled="False"/><Button x:Name="InsertButton" Grid.Column="2" Content="넣고 재생" Click="InsertCartridge" Background="#454C55" Foreground="#F1F1F1" BorderBrush="#353B43" IsEnabled="False"/></Grid>
                <Button x:Name="UnpackButton" Content="모음 풀기 · 게임팩 유지" Click="UnpackCollection" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel></ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,12,0,0" MinHeight="30"><Button x:Name="DeleteButton" Content="삭제" DockPanel.Dock="Right" BorderThickness="0" Padding="8,0" Click="DeleteCartridge" Visibility="Collapsed"/><TextBlock x:Name="Message" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    </Grid></Border>
</Window>
