<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FamicomPlayer</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets/Icon/FamicomPlayer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>FamicomPlayer.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <EmbeddedResource Include="Assets/console-v5.png" LogicalName="FamicomPlayer.Assets.console.png" />
    <EmbeddedResource Include="Assets/tv-v5.png" LogicalName="FamicomPlayer.Assets.tv.png" />
    <EmbeddedResource Include="Assets/pad-v5.png" LogicalName="FamicomPlayer.Assets.pad.png" />
    <EmbeddedResource Include="Assets/volume-knob-v4.png" LogicalName="FamicomPlayer.Assets.volume-knob.png" />
    <EmbeddedResource Include="Effects/CartridgeCrt.ps" LogicalName="FamicomPlayer.Assets.CartridgeCrt.ps" />
    <EmbeddedResource Include="Effects/HardwareFinish.ps" LogicalName="FamicomPlayer.Assets.HardwareFinish.ps" />
    <EmbeddedResource Include="Assets/cartridge-v5.png" LogicalName="FamicomPlayer.Assets.cartridge.png" />
    <EmbeddedResource Include="Assets/library-shell-v4.png" LogicalName="FamicomPlayer.Assets.library-shell.png" />
    <EmbeddedResource Include="Assets/default-cover-v2.png" LogicalName="FamicomPlayer.Assets.default-cover.png" />
    <EmbeddedResource Include="YouTubeBridge.js" LogicalName="FamicomPlayer.Assets.YouTubeBridge.js" />
    <EmbeddedResource Include="Assets/Icon/FamicomPlayer.ico" LogicalName="FamicomPlayer.Assets.App.ico" />
  </ItemGroup>
</Project>
