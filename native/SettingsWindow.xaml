<Window x:Class="FamicomPlayer.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FamicomPlayer"
    Title="FamicomPlayer 설정" Width="370" Height="740" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual" UseLayoutRounding="True" FontFamily="Malgun Gothic">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RetroTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#494949"/><Setter Property="FontSize" Value="12"/></Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="#494949"/><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="32"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center"/>
                        <Border x:Name="Switch" Grid.Column="1" Height="16" CornerRadius="8" Background="#D2D2D2" BorderBrush="#9C9C9C" BorderThickness=".8" VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="10" Height="10" Fill="#858585" HorizontalAlignment="Left" Margin="2"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="#AAAAAA"/><Setter TargetName="Switch" Property="BorderBrush" Value="#717171"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="#383D43"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="#383D43"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="#383D43"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SizeChoice" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#5F5F5F"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="29"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Choice" CornerRadius="5" Margin="2" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="#CDD2D9"/><Setter Property="Foreground" Value="#383D43"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="#D2D2D2"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="#818181"/><Setter TargetName="Choice" Property="BorderThickness" Value=".8"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SettingsAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="32"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="18,12,18,14" CornerRadius="12" Background="#FDE7E9EC" BorderBrush="#383D43" BorderThickness="2,2,2,6">
        <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Background="Transparent" MouseLeftButtonDown="DragHeader">
                <Button Width="28" Height="28" Padding="0" DockPanel.Dock="Right" Click="CloseSettings" ToolTip="닫기" AutomationProperties.Name="설정 닫기"><Path Data="M1,1 L9,9 M9,1 L1,9" Width="10" Height="10" Stroke="#494949" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                <TextBlock Text="설정" FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel><Grid Width="180" Height="120" Margin="0,0,0,14"><Image x:Name="PackShell" Stretch="Fill"/><local:CartridgeDisplay x:Name="PackPreview" Margin="18,16,18,27"/></Grid>
                    <DockPanel Margin="0,0,0,7"><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right"/><TextBlock Text="영상 불투명도"/></DockPanel>
                    <Slider x:Name="VideoOpacity" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ChromeFader}" ToolTip="0%: 투명 · 100%: 불투명" AutomationProperties.Name="영상 불투명도"/>
                    <DockPanel Margin="6,5,6,0"><TextBlock Text="불투명" DockPanel.Dock="Right" Foreground="#6F6F6F" FontSize="10"/><TextBlock Text="투명" Foreground="#6F6F6F" FontSize="10"/></DockPanel>
                    <Border Height="1" Background="#BCBCBC" Margin="0,16,0,8"/>
                    <CheckBox x:Name="PinOption" Content="항상 위에 표시"/>
                    <CheckBox x:Name="RotationOption" Content="게임팩 교체 애니메이션"/>
                    <CheckBox x:Name="EffectOption" Content="브라운관 필터"/>
                    <CheckBox x:Name="FlickerOption" Content="게임팩 LED의 희미한 깜빡임"/><CheckBox x:Name="ClickSoundOption" Content="게임팩 삽입 소리"/><DockPanel Margin="0,10,0,5"><TextBlock x:Name="CrtValue" DockPanel.Dock="Right"/><TextBlock Text="브라운관 필터 강도"/></DockPanel><Slider x:Name="CrtStrength" Minimum="0" Maximum="100" Style="{StaticResource ChromeFader}"/><CheckBox x:Name="AmbientOption" Content="화면 가장자리 빛 반사"/>
                    <DockPanel Margin="0,12,0,5"><TextBlock x:Name="HueValue" DockPanel.Dock="Right"/><TextBlock Text="색조"/></DockPanel>
                    <Slider x:Name="CrtHue" Minimum="-30" Maximum="30" Style="{StaticResource ChromeFader}" AutomationProperties.Name="CRT 색조"/>
                    <DockPanel Margin="0,8,0,5"><TextBlock x:Name="SaturationValue" DockPanel.Dock="Right"/><TextBlock Text="채도"/></DockPanel>
                    <Slider x:Name="CrtSaturation" Minimum="40" Maximum="140" Style="{StaticResource ChromeFader}" AutomationProperties.Name="CRT 채도"/>
                    <DockPanel Margin="0,8,0,5"><TextBlock x:Name="WarmthValue" DockPanel.Dock="Right"/><TextBlock Text="따뜻한 색감"/></DockPanel>
                    <Slider x:Name="CrtWarmth" Minimum="0" Maximum="40" Style="{StaticResource ChromeFader}" AutomationProperties.Name="CRT 따뜻한 색감"/>
                    <DockPanel Margin="0,12,0,7"><TextBlock x:Name="LightValue" DockPanel.Dock="Right"/><TextBlock Text="빛 퍼짐"/></DockPanel>
                    <Slider x:Name="LightStrength" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ChromeFader}" AutomationProperties.Name="빛 퍼짐"/>
                    <DockPanel Margin="0,12,0,7"><TextBlock x:Name="SizeValue" DockPanel.Dock="Right"/><TextBlock Text="전체 크기"/></DockPanel>
                    <Slider x:Name="WidgetSize" Minimum="50" Maximum="300" SmallChange="1" LargeChange="10" Style="{StaticResource ChromeFader}" AutomationProperties.Name="전체 크기" ToolTip="모서리 드래그 또는 Ctrl + 휠로도 조절"/>
                    <Button x:Name="ResetSize" Content="기본 크기" HorizontalAlignment="Right" Height="24" Margin="0,5,0,0"/>
                    <Border Height="1" Background="#BCBCBC" Margin="0,16,0,8"/>
                    <DockPanel Margin="0,0,0,6"><Button x:Name="RefreshOutputsButton" Content="↻" DockPanel.Dock="Right" Width="28" Height="26" ToolTip="출력 장치 새로고침"/><TextBlock Text="소리 출력 장치" VerticalAlignment="Center"/></DockPanel>
                    <ComboBox x:Name="AudioOutput" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" Foreground="#FF171717" AutomationProperties.Name="소리 출력 장치" ToolTip="FamicomPlayer 소리를 출력할 스피커 또는 헤드폰"/>
                    <TextBlock x:Name="AudioOutputStatus" Text="FamicomPlayer 소리에만 적용됩니다." FontSize="10" Foreground="#6F6F6F" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Border Height="1" Background="#BCBCBC" Margin="0,12,0,8"/>
                    <CheckBox x:Name="ObsOption" Content="OBS로 소리 보내기" ToolTip="스피커를 바꾸지 않고 FamicomPlayer 소리만 OBS에 전달"/>
                    <Button x:Name="CopyObsAddress" Content="OBS 연결 주소 복사" Style="{StaticResource SettingsAction}"/>
                    <TextBlock x:Name="ObsStatus" FontSize="10" Foreground="#6F6F6F" TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <Button x:Name="LibraryButton" Content="게임팩 보관함" Style="{StaticResource SettingsAction}" Background="#CDD2D9"/><Button x:Name="YouTubePageButton" Content="유튜브 페이지 보기" Style="{StaticResource SettingsAction}" ToolTip="로그인·동의·재생목록을 원래 페이지에서 조작"/>
                    <Button x:Name="DockButton" Content="오른쪽 아래로 정렬" Style="{StaticResource SettingsAction}"/>
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="HideButton" Content="숨기기" Style="{StaticResource SettingsAction}"/>
                        <Button x:Name="ExitButton" Content="종료" Grid.Column="1" Style="{StaticResource SettingsAction}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
